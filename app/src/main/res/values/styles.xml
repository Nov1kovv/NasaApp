<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name = "CustomSearchViewStyle">>
        <item name="android:background">@color/blue</item>
        <item name="android:iconifiedByDefault">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:queryHint">@string/search_for_images</item>
        <item name="android:layout_marginBottom">@dimen/grid_2</item>
    </style>

    <style name="DownloadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:padding">@dimen/grid_2</item>
    </style>

    <style name="ShareButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:padding">@dimen/grid_2</item>
    </style>

</resources>