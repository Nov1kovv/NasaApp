<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/customImageView"
        android:layout_width="@dimen/grid_25"
        android:layout_height="@dimen/grid_25"
        android:layout_margin="@dimen/grid_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_launcher_background" />

    <TextView
        android:id="@+id/customTextView"
        android:layout_width="0dp"
        style="@style/CustomStyle"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/grid_2"
        android:text="Название"
        app:layout_constraintBottom_toBottomOf="@+id/customImageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/customImageView"
        app:layout_constraintTop_toTopOf="@+id/customImageView" />

    <TextView
        android:id="@+id/customDateTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CustomStyle"
        android:layout_marginStart="@dimen/grid_2"
        android:text="Дата"
        app:layout_constraintBottom_toBottomOf="@+id/customImageView"
        app:layout_constraintStart_toEndOf="@+id/customImageView"
        app:layout_constraintTop_toBottomOf="@+id/customTextView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
