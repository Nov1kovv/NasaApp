<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@color/dark_gray">

    <ImageView
        android:id="@+id/customImageView"
        android:layout_width="@dimen/grid_25"
        android:layout_height="@dimen/grid_25"
        android:layout_marginStart="@dimen/grid_1"
        android:layout_marginBottom="@dimen/grid_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_launcher_background" />

    <ImageView
        android:id="@+id/videoIcon"
        android:layout_width="@dimen/grid_5"
        android:layout_height="@dimen/grid_5"
        android:layout_gravity="center"
        android:src="@drawable/ic_video"
        app:layout_constraintBottom_toBottomOf="@id/customImageView"
        app:layout_constraintEnd_toEndOf="@id/customImageView"
        app:layout_constraintStart_toStartOf="@id/customImageView"
        app:layout_constraintTop_toTopOf="@id/customImageView" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/grid_2"
        android:text="07.02.2025"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/customImageView"
        app:layout_constraintTop_toTopOf="@id/customImageView" />

    <TextView
        android:id="@+id/deschription"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/grid_2"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/customImageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/customImageView"
        app:layout_constraintTop_toBottomOf="@id/date"
        tools:text="Image Title jhgfgsdddddddddddds" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/grid_1"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/customImageView" />
</androidx.constraintlayout.widget.ConstraintLayout>
